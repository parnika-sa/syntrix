# ==============================================================================
# Syntrixmesh Solutions - Environment Variables Configuration
# ==============================================================================
# To enable real email delivery from the contact form:
# 1. Create a free account at https://resend.com
# 2. Generate an API Key under API Keys in the Resend dashboard
# 3. Create a .env.local file in this project root and paste the variables below.
# ==============================================================================

# Resend API Key (starts with re_...)
RESEND_API_KEY=re_your_api_key_here

# The recipient email where client inquiries should arrive (Default: info@syntrixmeshsolutions.com)
CONTACT_TO_EMAIL=info@syntrixmeshsolutions.com

# Verified sender email address configured in Resend (e.g. inquiries@syntrixmeshsolutions.com or onboarding@resend.dev for testing)
CONTACT_FROM_EMAIL=Syntrixmesh Inquiries <onboarding@resend.dev>

# Production Domain
NEXT_PUBLIC_SITE_URL=https://www.syntrixmeshsolutions.com
